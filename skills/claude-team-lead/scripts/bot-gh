#!/usr/bin/env bash
# Run `gh` as the owner's GitHub App (the agents' bot), in any repo the App is installed on.
#   bot-gh pr create --base dev --title "…" --body-file body.md
#   bot-gh issue comment 12 --body "…"
# Files next to this script: app-id (digits), private-key.pem (600).
# The installation token is minted from the key, cached ~50 min in token-cache (600), never printed.
# The App can read code and write issues/PRs/comments only: it cannot push or merge.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ID="$(cat "$DIR/app-id")"; KEY="$DIR/private-key.pem"; CACHE="$DIR/token-cache"
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
mint_token() {
  local now header payload unsigned sig jwt inst
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$APP_ID" | b64url)
  unsigned="$header.$payload"
  sig=$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign "$KEY" -binary | b64url)
  jwt="$unsigned.$sig"
  # One installation: the owner's account (repos are picked in the App's install settings).
  inst=$(curl -fsS -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app/installations" | python3 -c 'import sys,json;d=json.load(sys.stdin);print(d[0]["id"] if d else "")')
  [ -n "$inst" ] || { echo "bot-gh: the App is not installed anywhere" >&2; exit 1; }
  curl -fsS -X POST -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app/installations/$inst/access_tokens" | python3 -c 'import sys,json;print(json.load(sys.stdin)["token"])'
}
token=""
if [ -f "$CACHE" ]; then read -r exp tok < "$CACHE" || true; [ -n "${exp:-}" ] && [ "$(date +%s)" -lt "$exp" ] && token="$tok"; fi
if [ -z "$token" ]; then
  token="$(mint_token)"; [ -n "$token" ] || { echo "bot-gh: could not mint an installation token" >&2; exit 1; }
  (umask 077; printf '%s %s\n' $(( $(date +%s) + 3000 )) "$token" > "$CACHE")
fi
GH_TOKEN="$token" exec gh "$@"
